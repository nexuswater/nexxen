# Which model the agent uses: "<provider>:<model-id>"
#   claude-code:sonnet | claude-code:opus | claude-code:haiku   (no API key: uses your `claude` login)
#   anthropic:claude-opus-5-5 | anthropic:claude-sonnet-5-5 | openai:gpt-5.2
#   google:<gemini-model-id> | bedrock:<bedrock-model-or-inference-profile-id>
#   compatible:<model name your server exposes, e.g. an Ollama tag>
AI_MODEL=claude-code:sonnet
# Max tool-loop steps per turn
AI_MAX_STEPS=8

# claude-code needs no key. Optional: path to a specific claude binary.
# CLAUDE_CODE_PATH=/Users/you/.local/bin/claude

# Set only the key for the provider you use.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Bedrock uses the standard AWS credential chain
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Any OpenAI-compatible server (defaults to local Ollama)
# COMPATIBLE_BASE_URL=http://localhost:11434/v1
# COMPATIBLE_API_KEY=

# ── AP4M (Mastercard XRPL hackathon) ──
# Run `pnpm ap4m:wallets` to create AGENT_PRIVATE_KEY / MERCHANT_SUBMITTER_KEY / MERCHANT_PAYOUT.
AP4M_API_URL=https://hackathon.ap4m.build
AP4M_TEAM_NAME=
# AGENT_PRIVATE_KEY=
# Merchant ID from the portal (My setup)
MERCHANT_ID=
# MERCHANT_PAYOUT=
# MERCHANT_SUBMITTER_KEY=
# Business spending policy for the agent (RLUSD)
AP4M_MAX_CHANNEL_CAP=0.1
AP4M_MAX_PRICE=0.01
# One VEREV-approved spending block = the cap of the Channel it funds
AP4M_BLOCK_RLUSD=0.1
# City for the market-report service
NEXXEN_CITY=Bengaluru

# Hackathon demo (/demo)
OWNER_APPROVER_ADDRESS=        # owner's Ledger Flex address; only its signatures approve exceptions
OWNER_APPROVER_DEVICE=Ledger Flex
STORY_CARD_LIMIT_RLUSD=2       # per-purchase limit; larger purchases need the owner's signature
QUICKNODE_RPC_URL=             # Quicknode XRPL EVM Testnet endpoint for receipt verification (blank = public RPC)
