# Live adapter setup checklist only. The demo does not load this file automatically.
# Runtime supports APP_MODE=simulation, PORT, HOST, NEXXEN_DB; live payment flags do not activate transfers.
# Copy locally; keep real values private. Empty values mean UNAVAILABLE.
APP_MODE=simulation
POLICY_TIMEZONE=UTC
CREDIT_MODE=fixture
CREDIT_FIXTURE_VERSION=
RATE_POLICY_VERSION=
DAILY_CAP_RLUSD=
PER_REQUEST_CAP_RLUSD=

AP4M_ENABLED=false
AP4M_ENVIRONMENT=testnet
AP4M_API_BASE_URL=
AP4M_CREDENTIAL_SECRET_REF=
AP4M_SDK_VERSION=
AP4M_CHAIN_ID=
AP4M_RPC_URL=
AP4M_PARTICIPANT_REGISTRY_ADDRESS=
AP4M_PAYMENT_LEDGER_ADDRESS=
AP4M_POOLED_ESCROW_VAULT_ADDRESS=
RLUSD_TEST_TOKEN_ADDRESS=
RLUSD_TEST_TOKEN_DECIMALS=
AP4M_CONFIRMATION_POLICY=
OPERATIONAL_SIGNER_SECRET_REF=

LEDGER_ENABLED=false
LEDGER_MODEL=Flex
LEDGER_DEVICE_APP=Ethereum
LEDGER_OS_VERSION=
LEDGER_APP_VERSION=

QUICKNODE_ENABLED=false
QUICKNODE_RPC_SECRET_REF=

COMMERCIAL_CONNECT_ENABLED=false
COMMERCIAL_CONNECT_ENVIRONMENT=sandbox
COMMERCIAL_CONNECT_BASE_URL=
COMMERCIAL_CONNECT_CREDENTIAL_SECRET_REF=
COMMERCIAL_CONNECT_TEST_PROGRAM_ID=

LIVE_LENDING_ENABLED=false
BRIDGE_ENABLED=false
FX_ENABLED=false
LIVE_CARD_ISSUING_ENABLED=false

# READ-ONLY Marqeta public-sandbox connection check only.
# npm sandbox:check reads process environment; it does not load dotenv files.
# Optional explicit loader: node --env-file=.env.local scripts/sandbox-check.mjs
# Keep false until the user approves this GET check. Never paste real values in chat.
MARQETA_SANDBOX_READ_ENABLED=false
MARQETA_SANDBOX_BASE_URL=https://sandbox-api.marqeta.com/v3
MARQETA_APPLICATION_TOKEN=
MARQETA_ADMIN_ACCESS_TOKEN=
